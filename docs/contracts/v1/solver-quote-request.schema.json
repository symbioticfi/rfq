{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symbiotic.fi/rfq/contracts/v1/solver-quote-request.schema.json",
  "title": "SolverQuoteRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "tokenInChainId",
    "tokenOutChainId",
    "swapper",
    "tokenIn",
    "tokenOut",
    "amount",
    "type",
    "protocol",
    "numOutputs",
    "quoteId",
    "vaults"
  ],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "tokenInChainId": { "type": "integer", "minimum": 1 },
    "tokenOutChainId": { "type": "integer", "minimum": 1 },
    "swapper": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "tokenIn": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "tokenOut": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "amount": { "type": "string", "pattern": "^\\d+$" },
    "type": { "const": "EXACT_INPUT" },
    "protocol": { "const": "v1" },
    "numOutputs": { "type": "integer", "minimum": 1 },
    "quoteId": { "type": "string", "format": "uuid" },
    "vaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vault", "collateral", "collateralDecimals", "maxCollateralOut", "maxRate"],
        "properties": {
          "vault": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "collateral": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "collateralDecimals": { "type": "integer", "minimum": 0, "maximum": 255 },
          "maxCollateralOut": { "type": "string", "pattern": "^\\d+$" },
          "maxRate": { "type": "string", "pattern": "^\\d+$" }
        }
      }
    }
  }
}
