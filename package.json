{
  "name": "@symbiotic/rfq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "axios": "1.14.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter=!@symbiotic/rfq-integration build",
    "check": "pnpm -r --filter=!@symbiotic/rfq-integration check",
    "format": "pnpm -r --filter=!@symbiotic/rfq-integration format",
    "format:check": "pnpm -r --filter=!@symbiotic/rfq-integration format:check",
    "test": "pnpm -r --filter=!@symbiotic/rfq-integration test",
    "integration:test": "pnpm --dir ./integration test",
    "integration:check": "pnpm --dir ./integration check",
    "local:stop": "pnpm --dir ./integration local:stop",
    "local:dev": "pnpm --dir ./integration local:dev",
    "hoodi:stop": "pnpm --dir ./integration hoodi:stop",
    "hoodi:dev": "pnpm --dir ./integration hoodi:dev",
    "local:verify": "pnpm --dir ./integration local:verify"
  }
}
