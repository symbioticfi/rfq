{
    "name": "@symbiotic/rfq-frontend",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.24.0",
    "scripts": {
        "dev": "pnpm run sync:deployment && react-router dev",
        "sync:token-list": "node ./scripts/update-uniswap-token-list.mjs",
        "sync:deployment": "node ./scripts/sync-deployment.mjs",
        "build": "pnpm run sync:deployment && pnpm exec tsc -b && react-router build",
        "preview": "vite preview",
        "deploy:vercel": "sh -c 'pnpm dlx vercel@latest pull --yes --environment production && set -a && . .vercel/.env.production.local && set +a && pnpm build && mkdir -p build/client/.vercel && cp .vercel/project.json build/client/.vercel/project.json && cp vercel.json build/client/vercel.json && cd build/client && pnpm dlx vercel@latest deploy . --prod --yes --public'",
        "check": "pnpm exec tsc -p tsconfig.json --noEmit",
        "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
        "lint": "eslint src vite.config.ts react-router.config.ts eslint.config.js",
        "lint:fix": "eslint src vite.config.ts react-router.config.ts eslint.config.js --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "dependencies": {
        "@privy-io/react-auth": "^3.18.0",
        "@privy-io/wagmi": "^4.0.3",
        "@radix-ui/react-icons": "^1.3.2",
        "@react-router/node": "^7.13.2",
        "@tanstack/react-query": "^5.95.2",
        "buffer": "^6.0.3",
        "ethereum-blockies-base64": "^1.0.2",
        "isbot": "^5.1.37",
        "lucide-react": "^1.7.0",
        "motion": "^12.38.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router": "^7.13.2",
        "sonner": "^2.0.7",
        "viem": "^2.47.6",
        "wagmi": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@react-router/dev": "^7.13.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "eslint": "^10.1.0",
        "jsdom": "^29.0.1",
        "prettier": "^3.8.1",
        "typescript": "^6.0.2",
        "vite": "^8.0.3",
        "vitest": "^4.1.2"
    }
}
