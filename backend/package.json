{
    "name": "@symbiotic/rfq-backend",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.24.0",
    "scripts": {
        "sync:deployment": "node ./scripts/sync-deployment.mjs",
        "dev": "pnpm run sync:deployment && tsx watch src/index.ts",
        "build": "pnpm run sync:deployment && tsc -p tsconfig.json",
        "start": "pnpm run sync:deployment && tsx src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm run build && pnpm run test",
        "seed:solver": "pnpm run sync:deployment && tsx scripts/seed-solver.ts",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.12",
        "@hono/standard-validator": "^0.2.2",
        "@scalar/hono-api-reference": "^0.10.5",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.9",
        "hono-openapi": "^1.3.0",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "prom-client": "^15.1.3",
        "viem": "^2.47.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^0.31.10",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
